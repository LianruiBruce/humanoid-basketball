#usda 1.0
(
    defaultPrim = "Hoop"
    metersPerUnit = 1
    upAxis = "Z"
)

# Basketball hoop. Origin = rim center. Robot shoots along +X, so the backboard sits behind the rim at +X.
# Rim: 16 capsules on a circle of radius 0.12 m (ball radius 0.035 m).
def Xform "Hoop" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 2.0

    def Cube "Backboard" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.95, 0.95, 0.95)]
        double3 xformOp:translate = (0.18, 0, 0.14)
        float3 xformOp:scale = (0.02, 0.6, 0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

